
# Database Configuration (SQLite default, switchable to PostgreSQL on AWS RDS)
DATABASE_URL=sqlite:///./docs_qa.db

# Qdrant Vector DB Configuration (local embedded disk mode default)
QDRANT_STORAGE_PATH=./qdrant_storage
# QDRANT_URL=http://localhost:6333  # Optional: for standalone/cloud Qdrant

# AI API Keys (Optional: Gemini text-embedding-004 and Flash synthesis)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Server & Network Configuration
PORT=8000
HOST=0.0.0.0
BACKEND_URL=http://localhost:8000

# Retrieval & Abstention Parameters
CONFIDENCE_THRESHOLD=0.35